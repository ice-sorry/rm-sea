# Copy to .env.local and fill from Firebase console → Project settings → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=srl-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=srl-dev
VITE_FIREBASE_APP_ID=

# Discord application (public — the secret lives in the Cloudflare Worker)
VITE_DISCORD_CLIENT_ID=1569644221718331412

# Cloudflare Worker URL (Discord sign-in, bot, webhooks). Leave empty locally: emulator mode uses http://localhost:8787
VITE_API_URL=

# Social links shown in the top bar
VITE_DISCORD_INVITE=https://discord.gg/PmDC2zECZj
VITE_YOUTUBE_URL=

# true = connect to the local Emulator Suite and show dev sign-in buttons
VITE_USE_EMULATORS=true
